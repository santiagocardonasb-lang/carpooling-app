PORT=3001
JWT_SECRET=cambia-esto-en-produccion

# PostgreSQL / Supabase
# Obtén la URL en: Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Envío de correo para recuperación de contraseña (Brevo)
# Clave: Brevo → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=xkeysib-...
# Remitente ya verificado en Brevo → Senders, Domains & Dedicated IPs → Senders
MAIL_FROM=tucorreo@gmail.com
MAIL_FROM_NAME=Carpool
